public static List<String> findLine(RandomAccessFile a, ArrayList<String> b, int maxLength) throws IOException {

    String search = b.get(0);//index 0 is the keyword
    b.clear();

    long recordSize = (maxLength * 2) + 2; 
    long totalRecords = a.length() / recordSize;

    long lineNumber = 0;

    for (long i = 2; i < totalRecords; i++) {

        long offset = i * recordSize;
        a.seek(offset);

        String raw = "";//empty since it will be filled later
        for (int c = 0; c < maxLength; c++) {
            raw += a.readChar();
        }

        a.readChar();

        String clean = separate(raw).trim();

        if (clean.toLowerCase().contains(search.toLowerCase())) {//turns keyword and potential result to lowercase
                                                                 //for easier comparison
            lineNumber = i + 1;
            b.add(clean);
            b.add(String.valueOf(lineNumber));
            return b;
        }
    }

    b.add("NOT FOUND");
    b.add("0");
    return b;
}

public static List<String> getCat(RandomAccessFile a, ArrayList<String> out, int maxLength) throws IOException {

    out.clear();//makes sure arraylist is empty since this is what the categories will be stored in

    long recordSize = (maxLength * 2) + 2;

    long offset = recordSize;  
    a.seek(offset);//puts the cursor at the start of where the second line begins

    String raw = "";
    for (int i = 0; i < maxLength; i++) {
        raw += a.readChar();
    }

    a.readChar(); 

    String clean = separate(raw).trim();

    String[] parts = clean.split(", ");

    for (int i = 1; i < parts.length; i++) {
        out.add(parts[i]);
    }

    return out;
}

public static String separate(String string){

    string = string.replace("[", "").replace("]", "");
//since the replacement spot is empty, this is just deleting the brackts

    string = string.replace("@@", ", ");//replaces separator with comma

    string = string.replace("@", " "); //replaces space separator with space

    string = string.trim().replaceAll(" +", " ");//replaces double spaces with single space

    return string;
}

public static void add(RandomAccessFile a, ArrayList<String> categories, int maxlength) throws IOException{

Scanner input =  new Scanner(System.in);

ArrayList<String> data = new ArrayList<>();

for(int i = 0; i < categories.size(); i++){
    int currentCat = i + 1;
    System.out.println("What do you want Category " + currentCat + ": " + categories.get(i) + " to be?");
    String answer = input.nextLine();
    data.add(answer + "@");
}

Write(a, data, maxlength);

}

public static void edit(RandomAccessFile a, ArrayList<String> categories, int maxLength) throws IOException {

    Scanner input = new Scanner(System.in);

    System.out.println("What entry do you want to edit? Enter a word from that entry:");
    String keyword = input.nextLine();

    ArrayList<String> searchList = new ArrayList<>();
    searchList.add(keyword);

    List<String> result = findLine(a, searchList, maxLength);

    String foundLine = result.get(0);
    long lineNumber = Long.parseLong(result.get(1));

    if (lineNumber == 0) {//since the findline method returns the line number or zero if no entry found, a line number of zero
                          //means no entry
        System.out.println("No matching entry found.");
        return;
    }

    System.out.println("Entry found:");
    System.out.println(foundLine);

    System.out.println("Which category do you want to change?");
    for (int i = 0; i < categories.size(); i++) {
        System.out.println(i + ": " + categories.get(i));
    }

    int index = input.nextInt();
    input.nextLine(); 

    System.out.println("Enter the new value:");
    String newValue = input.nextLine();

    String[] fields = foundLine.split(", ");

    fields[index] = newValue;//changes the data at the specified index to the new data

    ArrayList<String> rebuilt = new ArrayList<>();

    
    for (String f : fields) {
        rebuilt.add(f + "@@");
    }

    long recordSize = (maxLength * 2) + 2;
    long offset = (lineNumber - 1) * recordSize;

    a.seek(offset);
    Write(a, rebuilt, maxLength);

    System.out.println("Entry edited successfully.");

}

public static void search(RandomAccessFile a, int maxLength) throws IOException {

    Scanner input = new Scanner(System.in);

    System.out.println("What are you looking for?");
    String keyword = input.nextLine().toLowerCase();

    long recordSize = (maxLength * 2) + 2;//length of each line
    long totalRecords = a.length() / recordSize;//= size of file / length of each line

    System.out.println("Here are the results:");

    for (long i = 2; i < totalRecords; i++) {

        long offset = i * recordSize;
        a.seek(offset);

        String raw = "";
        for (int c = 0; c < maxLength; c++) {
            raw += a.readChar();
        }

        a.readChar(); // skip newline

        String clean = separate(raw).trim();

        if (clean.toLowerCase().contains(keyword)) {
            System.out.println(clean);
        }
    }

}

public static void delete(RandomAccessFile a, int maxLength) throws IOException {

    Scanner input = new Scanner(System.in);

    System.out.println("Enter a keyword from the entry you want to delete:");
    String keyword = input.nextLine();

    ArrayList<String> searchList = new ArrayList<>();
    searchList.add(keyword);

    List<String> result = findLine(a, searchList, maxLength);

    String foundLine = result.get(0);
    long lineNumber = Long.parseLong(result.get(1));

    if (lineNumber == 0) {
        System.out.println("No matching entry found.");
        return;
    }

    System.out.println("Found entry:");
    System.out.println(foundLine);

    System.out.println("Are you sure you want to delete this entry? (yes/no)");
    String confirm = input.nextLine();

    if (!confirm.equalsIgnoreCase("yes")) {//anything other than yes will cancel the deletion process
        System.out.println("Deletion cancelled.");
        return;
    }

    ArrayList<String> deleted = new ArrayList<>();
    deleted.add("DELETED@@");

    long recordSize = (maxLength * 2) + 2;
    long offset = (lineNumber - 1) * recordSize;

    a.seek(offset);
    Write(a, deleted, maxLength);

    System.out.println("Entry deleted successfully.");

}



