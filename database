public class database {
    
public static boolean usePassword(RandomAccessFile a, int maxLength) throws IOException, InterruptedException {

    Scanner input = new Scanner(System.in);

    a.seek(0);

    String raw = "";//empty since this is where the first line of the file will go
    for (int i = 0; i < maxLength; i++) {
        raw += a.readChar();
    }

    a.readChar();

    String clean = separate(raw).trim();//trimming and separating String raw

    String[] parts = clean.split(", ");//splitting clean

    if (parts.length < 3) {
        System.out.println("Password record is corrupted. Please create a new password.");
        //there are three parts to the password line, 'password' to define the line,
        //whether there is a password, and the password. if there are less than three parts
        //in the array than the password in corrupted
        return false;
    }

    String used = parts[1];       
    String password = parts[2]; 
    password = password.replace(",", "");  

    if (used.equalsIgnoreCase("false")) {
        return true;//if there is no password returns that no password is needed
    }

    System.out.println("This database is password protected.");


int numIncAtt = 0;
Boolean complete = true;

do{//for if their is a password
    complete = true;

    System.out.print("Enter password: ");
    String attempt = input.nextLine();

    if (attempt.equals(password)) {//obviously the password must match exactly, thus no trimming, separating, or case changing
        System.out.println("Access granted.");
        return true;
    } else {
        System.out.println("Incorrect password.");
        complete = false;
        numIncAtt ++;
    }
    if(numIncAtt == 10){//lockout mechanism
    System.out.println("Sorry, too many incorrect attempts to open. Please try again in 5 minutes.");
    TimeUnit.MINUTES.sleep(5);//only way to reset this is to completely stop the program and restart it
    numIncAtt = 0;//resets number of incorrect attempts so can be done again if necessary
    }

}while(!complete);

return true;

}

public static void changePassword(RandomAccessFile a, int maxLength) throws IOException {

    Scanner input = new Scanner(System.in);

    a.seek(0);

    String raw = "";
    for (int i = 0; i < maxLength; i++) {
        raw += a.readChar();
    }

    a.readChar();

    String clean = separate(raw).trim();

    String[] parts = clean.split(", ");

    if (parts.length < 3) {//explained earlier
        System.out.println("Password record is corrupted.");
        return;
    }

    String used = parts[1];       
    String oldPassword = parts[2];

    if (used.equalsIgnoreCase("false")) {//if there is no password
        System.out.println("Password protection is currently OFF.");
        System.out.println("Do you want to enable it? Please input yes or no.");
        String ans = input.nextLine();

        if (!ans.equalsIgnoreCase("yes")) {//if answer is anything but yes password status is unchanged
            System.out.println("Password unchanged.");
            return;
        }

        System.out.println("Enter new password:");
        String newPass = input.nextLine();

        ArrayList<String> record = new ArrayList<>();
        record.add("Password@@true@@");
        record.add(newPass + "@@");

        a.seek(0);
        Write(a, record, maxLength);

        System.out.println("Password enabled and saved.");
        return;
    }

    System.out.println("Enter current password:");// must know current password in order to change password
    String attempt = input.nextLine();

    if (!attempt.equals(oldPassword)) {
        System.out.println("Incorrect password. Cannot change password.");
        return;
    }

    System.out.println("Enter new password:");//new password verification
    String newPassword = input.nextLine();

    ArrayList<String> updated = new ArrayList<>();
    updated.add("Password@@true@@");
    updated.add(newPassword + "@@");

    a.seek(0);
    Write(a, updated, maxLength);

    System.out.println("Password changed successfully.");

}

public static void Write(RandomAccessFile a, ArrayList<String> text, int maxLength) throws IOException {

    StringBuilder build = new StringBuilder();
    for (String s : text) {
        build.append(s);
    }

    if (build.length() > maxLength) {//if text is too long it shortens it
        build.setLength(maxLength);
    }

    while (build.length() < maxLength) {//if text is to short it adds spaces
        build.append(' ');
    }

    a.seek(a.length());

    a.writeChars(build.toString());

    a.writeChar('\n');
}

